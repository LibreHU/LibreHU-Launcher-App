<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- List every launchable app. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Privileged install: real force stop, system-wide light / dark mode. -->
    <uses-permission
        android:name="android.permission.FORCE_STOP_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.MODIFY_DAY_NIGHT_MODE"
        tools:ignore="ProtectedPermissions" />
    <!-- Privileged install: place widgets without asking the user each time. -->
    <uses-permission
        android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />

    <!-- LibreHU-service API (volume). Install LibreHU-service first so that this permission is granted. -->
    <uses-permission android:name="org.librehu.permission.HEADUNIT" />

    <!-- SOS (sos/SosActivity): calls through the Bluetooth phone, position for the rescue. CALL_PRIVILEGED
         (privileged install) also calls emergency numbers directly, ACTION_CALL cannot. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission
        android:name="android.permission.CALL_PRIVILEGED"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Spectrum wallpaper following the music (Visualizer on the output mix). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Phone of the car (HFP client: operator, signal, battery). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Control center: Wi-Fi and Bluetooth switches, brightness ("Modify system settings", asked once). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Power menu: privileged install, else root. -->
    <uses-permission
        android:name="android.permission.REBOOT"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.SHUTDOWN"
        tools:ignore="ProtectedPermissions" />

    <!-- USB TPMS receiver (USB-serial adapter). -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LibreHU.Car">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Front panel touch keys of LibreHU-service, key mapping: power menu, app drawer. -->
            <intent-filter>
                <action android:name="org.librehu.action.POWER_MENU" />
                <action android:name="org.librehu.action.ALL_APPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- USB TPMS receivers: same USB-serial adapters as the original TPMS apps. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/tpms_device_filter" />
        </activity>

        <!-- Standby clock: from the home screen, the rail clock, or org.librehu.action.STANDBY_CLOCK (key mapping). -->
        <activity
            android:name=".standby.StandbyActivity"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="org.librehu.launcher.standby"
            android:theme="@style/Theme.LibreHU.Car">
            <intent-filter>
                <action android:name="org.librehu.action.STANDBY_CLOCK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Lock screen: power menu, or org.librehu.action.LOCK (front panel touch keys, key mapping). -->
        <activity
            android:name=".lock.LockActivity"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="org.librehu.launcher.lock"
            android:theme="@style/Theme.LibreHU.Car">
            <intent-filter>
                <action android:name="org.librehu.action.LOCK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The standby clock as Android's screen saver. -->
        <service
            android:name=".standby.StandbyDream"
            android:exported="true"
            android:label="@string/standby_title"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- SOS screen: rail / dashboard button, widget, or org.librehu.action.SOS (key mapping). -->
        <activity
            android:name=".sos.SosActivity"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="org.librehu.launcher.sos"
            android:theme="@style/Theme.LibreHU.Car">
            <intent-filter>
                <action android:name="org.librehu.action.SOS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- SOS button widget. -->
        <receiver
            android:name=".sos.SosWidget"
            android:exported="true"
            android:label="@string/sos">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sos_widget_info" />
        </receiver>

        <!-- Effective light / dark theme for the other LibreHU apps (read only, no private data). -->
        <provider
            android:name=".data.ThemeProvider"
            android:authorities="org.librehu.launcher.theme"
            android:exported="true" />

        <!-- Tyre pressure widget (launcher slots or any home screen). -->
        <receiver
            android:name=".tpms.TpmsWidget"
            android:exported="true"
            android:label="@string/tpms_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tpms_widget_info" />
        </receiver>

        <service
            android:name=".data.MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
