<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/limit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <TextView
        android:id="@+id/limit_value"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:background="@drawable/limit_sign"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="—"
        android:textColor="#FF202124"
        android:textSize="38sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/limit_value_seg"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:background="@drawable/limit_sign"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <TextView
        android:id="@+id/limit_road"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#FF9AA0A6"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/limit_road_seg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="centerInside"
        android:visibility="gone" />

</FrameLayout>
