<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/weather_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text="🌡️"
        android:textSize="48sp" />

    <ImageView
        android:id="@+id/weather_symbol_seg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/weather_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:text="—"
            android:textColor="#FFE8EAED"
            android:textSize="48sp" />

        <ImageView
            android:id="@+id/weather_temp_seg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:visibility="gone" />

        <TextView
            android:id="@+id/weather_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF9AA0A6"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/weather_label_seg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:visibility="gone" />

        <TextView
            android:id="@+id/weather_minmax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF9AA0A6"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/weather_minmax_seg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>
